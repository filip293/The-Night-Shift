; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ResCleaner]

data/keep_list=Array[String](["res://.DS_Store", "res://.editorconfig", "res://characters/.DS_Store", "res://characters/Monster.glb", "res://default_bus_layout.tres", "res://Fonts/PixeloidMono.ttf", "res://introAssets/moto-v3i.glb", "res://map/gas_station.glb", "res://MapAssets/.DS_Store", "res://MapAssets/broom_psx.glb", "res://MapAssets/Bucket and mop/BucketAndMop.glb", "res://MapAssets/Cars/Car1.glb", "res://MapAssets/Cars/Car2.glb", "res://MapAssets/Cars/Car3.glb", "res://MapAssets/Cars/Car4.glb", "res://MapAssets/Crate/Crate.glb", "res://MapAssets/Ice/.DS_Store", "res://MapAssets/Ice/Ice.glb", "res://MapAssets/optimized_shelf.glb", "res://MapAssets/Puddle/Puddle.glb", "res://MapAssets/radio.glb", "res://MapAssets/SUV/suv.glb", "res://MapAssets/wet_floor_sign.glb", "res://monster.gd", "res://monsterAnim/fall_back.res", "res://PSX_NIGHTSKY.hdr", "res://scripts/AutoSetNearest.gd", "res://scripts/tvscreen.gd", "res://shaders/glass.gdshader", "res://Sounds/.DS_Store", "res://Sounds/cartoon-sliping-and-crash.mp3", "res://Sounds/Car_Engine_Loop.ogg", "res://Sounds/Car_Engine_Loop_2.ogg", "res://Sounds/drone.mp3", "res://Sounds/jumpscare.mp3", "res://Sounds/MetalDoorClose.mp3", "res://Sounds/MetalDoorOpen.mp3", "res://Sounds/openNEW.mp3", "res://Sounds/Radio/.DS_Store", "res://Sounds/shutNEW.mp3", "res://Sounds/voiceline/v1.mp3", "res://Sounds/voiceline/v2.mp3", "res://Sounds/voiceline/v3.mp3", "res://Sounds/voiceline/v4.mp3", "res://TheNightShift.tscn"])

[accessibility]

general/accessibility_support=2
general/accessibility_driver="dummy"

[application]

config/name="The Night Shift"
run/main_scene="uid://bw2njfn37y3nr"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://utdqhia8kmfn"

[autoload]

Globals="*uid://dd1yobt5cerai"

[debug]

settings/stdout/print_fps=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/dpi/allow_hidpi=false
window/scale=1.0

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godotresourcecleaner/plugin.cfg", "res://addons/post_processing/plugin.cfg")

[filesystem]

import/blender/enabled=false

